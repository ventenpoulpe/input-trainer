[gd_scene format=3]

[ext_resource type="Script" path="res://ui/settings_menu.gd" id="1_settings"]

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.65)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "SETTINGS / REBIND"
horizontal_alignment = 1

[node name="Columns" type="HBoxContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Bindings" type="VBoxContainer" parent="Center/Panel/Margin/VBox/Columns"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="BindingGrid" type="GridContainer" parent="Center/Panel/Margin/VBox/Columns/Bindings"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 6
columns = 3

[node name="UseStickCheck" type="CheckBox" parent="Center/Panel/Margin/VBox/Columns/Bindings"]
unique_name_in_owner = true
layout_mode = 2
text = "Left analog stick also controls directions"

[node name="ColumnSeparator" type="VSeparator" parent="Center/Panel/Margin/VBox/Columns"]
layout_mode = 2

[node name="Preferences" type="VBoxContainer" parent="Center/Panel/Margin/VBox/Columns"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
theme_override_constants/separation = 10

[node name="PreferencesTitle" type="Label" parent="Center/Panel/Margin/VBox/Columns/Preferences"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.68, 0.8, 1)
text = "PREFERENCES"

[node name="PrefsGrid" type="GridContainer" parent="Center/Panel/Margin/VBox/Columns/Preferences"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 10
columns = 2

[node name="StatusLabel" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.4, 1)
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="ResetButton" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Reset to Defaults"

[node name="CancelButton" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Cancel"

[node name="SaveButton" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Save"
